<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permits local adb reverse (127.0.0.1) and LAN hackathon demo servers -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

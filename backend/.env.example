# Gnani API Configuration
GNANI_API_KEY=mock_gnani_key
# When MOCK_GNANI=true, the orchestrator simulates Prisma v3.0 STT & Timbre v3.0 TTS
MOCK_GNANI=true
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts

# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Audio & VAD Configuration
SAMPLE_RATE=16000
VAD_SILENCE_TAIL_MS=550
VAD_SPEECH_THRESHOLD=0.5

# Server Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///asha_visits.db
